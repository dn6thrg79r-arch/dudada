{
  "name": "dudada-study",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "postinstall": "node scripts/pdf-assets.mjs && node scripts/presentation-assets.mjs",
    "format": "prettier --write app lib tests scripts *.ts *.mjs *.json README.md",
    "build:pages": "node scripts/build-pages.mjs",
    "preview:pages": "node scripts/serve-pages.mjs",
    "test:pages": "node scripts/test-pages.mjs",
    "test:cloud": "node scripts/test-cloud.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "cfb": "^1.2.2",
    "fflate": "^0.8.2",
    "idb": "^8.0.0",
    "jszip": "^3.10.2",
    "lucide-react": "^0.468.0",
    "marked": "^17.0.6",
    "next": "^16.0.0",
    "pdfjs-dist": "^6.5.438",
    "pptx-preview": "^1.0.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "pdf-lib": "^1.17.1",
    "pptxgenjs": "^4.0.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
